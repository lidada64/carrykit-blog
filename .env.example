# 环境变量清单见 docs/ARCHITECTURE.md §6;复制为 .env 并填入真实值(.env 不入库)

# SQLite 路径(本地开发;生产容器内为 file:/data/blog.db)
DATABASE_URL="file:./dev.db"

# session cookie 加密密钥,32+ 随机字符(M2 鉴权使用)
SESSION_SECRET=""

# seed 创建的管理员凭据；ADMIN_PASSWORD 必填，缺失或空白时 seed 拒绝写入
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# 站点公开地址,用于 sitemap/OG(M3 使用)
SITE_URL="http://localhost:3000"

# 上传图片存储目录(M5 图片上传;Docker 生产为 /data/uploads)
UPLOAD_DIR="./uploads"

# Docker only: production public hostname (without https://); local default :80
SITE_DOMAIN=":80"

# Fixture preview only. Keep false in production; this is NOT a live Agent switch.
ASSISTANT_PREVIEW_ENABLED="false"

# Live assistant stays off until the launch matrix is complete. Private origin only.
ASSISTANT_ENABLED="false"
# Enable only after the sole trusted Caddy proxy overwrites X-Carrykit-Client-IP.
ASSISTANT_TRUST_PROXY_HEADER="false"
AGENT_BASE_URL="http://agent:8000"
# Three distinct random secrets, each >=32 UTF-8 bytes; all differ from SESSION_SECRET.
AGENT_REQUEST_SECRET=""
AGENT_CONTENT_SECRET=""
VISITOR_SESSION_SECRET=""

# Required by docker-compose.preflight.yml. Resolve actual names from the existing
# production containers; never guess names from the local workspace directory.
# Leave blank for the original local Compose; fill ALL four before the overlay.
COMPOSE_PROJECT_NAME=""
BLOG_DATA_VOLUME=""
CADDY_DATA_VOLUME=""
CADDY_CONFIG_VOLUME=""

# Optional existing admin translation provider; never use NEXT_PUBLIC_* for keys.
DEEPSEEK_API_KEY=""
